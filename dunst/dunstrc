[global]
    monitor = 0
    follow = keyboard
    width = (250, 500)
    height = (30, 750)
    offset = (15, 35)
    padding = 5
    horizontal_padding = 5
    gap_size = 3
    transparency = 35
    frame_width = 1
    frame_color="#607566"
    font = Noto Sans 11
    corner_radius = 3
    min_icon_size = 32
    max_icon_size = 32
    format = "<b>%s</b>\n%b"

[urgency_low]
    foreground = "#0A2E15"
    background = "#68B351"
    timeout = 3

[urgency_normal]
    foreground = "#3c3836"
    background = "#ebdbb2"
    timeout = 5

[urgency_critical]
    background = "#C1CAC4"
    foreground = "#0A2E15"
    frame_color = "#ff0000"
    timeout = 15
