/* ROFI VERTICAL THEME USING THE NORD COLOR PALETTE */
/* Author: Newman Sanchez (https://github.com/newmanls) */

* {
    font:   "Noto Sanas Mono 12";

    gruvbox0:     #251f1b;
    gruvbox1:     #3b4252;
    gruvbox2:     #434c5e;
    gruvbox3:     #4c566a;

    gruvbox4:     #d8dee9;
    gruvbox5:     #e5e9f0;
    gruvbox6:     #ebdbb2;

    gruvbox7:     #83a598;
    gruvbox8:     #88c0d0;
    gruvbox9:     #458588;
    gruvbox10:    #5e81ac;
    gruvbox11:    #b16286;

    gruvbox12:    #fb4934;
    gruvbox13:    #d79921;
    gruvbox14:    #8ec07c;
    gruvbox15:    #d3869b;

    background-color:   transparent;
    text-color:         @gruvbox4;
    accent-color:       @gruvbox6;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    background-color:   @gruvbox0;
    border-color:       @gruvbox10;

    location:   center;
    width:      480px;
    border:     1px;
}

inputbar {
    padding:    8px 12px;
    spacing:    12px;
    children:   [ prompt, entry ];
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    text-color: @accent-color;
}

listview {
    lines:      8;
    columns:    1;

    fixed-height:   false;
}

element {
    padding:    8px;
    spacing:    8px;
}

element normal urgent {
    text-color: @gruvbox13;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

element selected {
    text-color: @gruvbox0;
}

element selected normal {
    background-color:   @accent-color;
}

element selected urgent {
    background-color:   @gruvbox13;
}

element selected active {
    background-color:   @gruvbox1;
}

element-icon {
    size:   0.75em;
}

element-text {
    text-color: inherit;
}
